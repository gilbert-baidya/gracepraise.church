{
  "scripts": {
    "seo:audit": "node scripts/seo-audit.mjs",
    "seo:sitemap": "node scripts/generate-sitemap.mjs",
    "perf:audit": "node scripts/performance-audit.mjs",
    "pom:generate": "node scripts/generate-playwright-poms.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:dashboard": "./open-dashboard.sh && playwright test",
    "test:smoke": "playwright test tests/smoke",
    "test:devotion": "playwright test tests/devotion",
    "test:visual": "playwright test tests/visual",
    "test:navigation": "playwright test tests/navigation",
    "test:accessibility": "playwright test tests/accessibility",
    "test:regression": "playwright test tests/navigation/navigation-integrity.spec.ts tests/devotion/lent-and-gratitude-regression.spec.ts tests/devotion/critical-navigation-and-render-regression.spec.ts tests/regression/device-theme-regression.spec.ts --workers=2",
    "test:regression:matrix": "playwright test tests/regression/device-theme-regression.spec.ts --workers=2",
    "test:regression:critical": "playwright test tests/devotion/critical-navigation-and-render-regression.spec.ts --workers=2",
    "test:regression:dropdown-light": "playwright test tests/devotion/critical-navigation-and-render-regression.spec.ts --grep \"Desktop light-mode dropdown links remain readable\" --project='Desktop Chrome' --project='Desktop Safari' --project='Desktop Firefox' --workers=2",
    "test:desktop": "playwright test --project='Desktop Chrome'",
    "test:tablet": "playwright test --project='iPad Pro 11 Portrait'",
    "test:mobile": "playwright test --project='iPhone 14'",
    "test:report": "playwright show-report",
    "test:phonetic-v2": "node --test tests/phonetic-v2.test.js",
    "test:v21:schema": "node scripts/verify-v21-schema.mjs",
    "test:v21:rules": "firebase emulators:exec --only firestore,auth \"node --test tests/firebase/firestore.rules.test.js\"",
    "test:v21:functions": "firebase emulators:exec --only auth,firestore,functions \"node --test tests/firebase/functions.integration.test.js\"",
    "test:v21:backend": "npm --prefix functions test",
    "test:v21:backend:lint": "npm --prefix functions run lint",
    "test:v21:admin": "playwright test tests/admin/v21-control-center.spec.ts --project='Desktop Chrome'",
    "test:v21:adapter": "playwright test tests/website-control/website-control.spec.ts --project='Desktop Chrome'",
    "test:debug": "playwright test --debug",
    "dashboard": "./open-dashboard.sh"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "dotenv": "^17.2.4",
    "fs-extra": "^11.3.3",
    "openai": "^6.21.0",
    "p-limit": "^7.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.10",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.31.0",
    "typescript": "^5.8.2"
  }
}
