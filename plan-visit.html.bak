    <script src="navigation.js?v=20260125c"></script>
    <script src="events.js" defer></script>
    <script defer>
        // Language Toggle Functionality
        (function() {
            const STORAGE_KEY = 'gpbc-language';
            let currentLang = localStorage.getItem(STORAGE_KEY) || 'en';
            
            function switchLanguage(lang) {
                currentLang = lang;
                localStorage.setItem(STORAGE_KEY, lang);
                
                // Hide all language elements
                document.querySelectorAll('[data-lang]').forEach(el => {
                    el.style.display = 'none';
                });
                
                // Show selected language elements
                document.querySelectorAll(`[data-lang="${lang}"]`).forEach(el => {
                    el.style.display = '';
                });
                
                // Update button active state
                document.querySelectorAll('[data-lang-btn]').forEach(btn => {
                    if (btn.dataset.langBtn === lang) {
                        btn.classList.add('active');
                    } else {
                        btn.classList.remove('active');
                    }
                });
                
                // Update HTML lang attribute
                document.documentElement.lang = lang;
            }
            
            // Initialize on page load
            document.addEventListener('DOMContentLoaded', function() {
                // Set up toggle button click handler
                const toggleBtn = document.getElementById('langToggleBtn');
                if (toggleBtn) {
                    toggleBtn.addEventListener('click', function() {
                        const newLang = currentLang === 'en' ? 'bn' : 'en';
                        switchLanguage(newLang);
                    });
                }
                
                // Apply saved language preference
                switchLanguage(currentLang);
            });
        })();
        
        // Populate upcoming highlights with next 2 important events
        document.addEventListener('DOMContentLoaded', function() {
            const highlightsContainer = document.getElementById('upcomingHighlights');
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            
            // Category emoji mapping
            const categoryEmoji = {
                'christian': '✝️',
                'gpbc': '🎉',
                'bangladeshi': '🇧🇩',
                'american': '🇺🇸',
                'special': '⭐'
            };
            
            // Filter and sort upcoming events
            const upcomingEvents = events
                .filter(event => {
                    const eventDate = new Date(event.date);
                    return eventDate >= today;
                })
                .sort((a, b) => new Date(a.date) - new Date(b.date))
                .slice(0, 2); // Get next 2 events
            
            // Add each event to the highlights
            upcomingEvents.forEach(event => {
                const eventDate = new Date(event.date);
                const dateStr = eventDate.toLocaleDateString('en-US', { 
                    weekday: 'long', 
                    year: 'numeric', 
                    month: 'long', 
                    day: 'numeric' 
                });
                
                const highlightItem = document.createElement('div');
                highlightItem.className = 'highlight-item';
                highlightItem.innerHTML = `
                    <div class="highlight-icon">${categoryEmoji[event.category] || '📅'}</div>
                    <div class="highlight-content">
                        <h3>${event.name}</h3>
                        <p class="highlight-date">${dateStr}</p>
                        <p class="highlight-desc">${event.description || ''}</p>
                    </div>
                `;
                highlightsContainer.appendChild(highlightItem);
            });
        });
        
        // Add to Calendar Functionality
        (function() {
            // Event details for Sunday Worship
            const eventDetails = {
                title: 'Sunday Worship Service – Grace and Praise Bangladeshi Church',
                description: 'Join us for worship, prayer, and Bible-based message. Everyone is welcome!',
                location: '1325 Richardson Street, CA 92408',
                // Using next Sunday as start date, then recurring weekly
                startTime: getNextSunday(),
                duration: 90 // minutes
            };
            
            // Get next Sunday at 5:00 PM
            function getNextSunday() {
                const now = new Date();
                const daysUntilSunday = (7 - now.getDay()) % 7 || 7;
                const nextSunday = new Date(now);
                nextSunday.setDate(now.getDate() + daysUntilSunday);
                nextSunday.setHours(17, 0, 0, 0); // 5:00 PM
                return nextSunday;
            }
            
            // Format date for Google Calendar (yyyyMMddTHHmmss)
            function formatGoogleDate(date) {
                return date.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';
            }
            
            // Generate Google Calendar URL
            function generateGoogleCalendarUrl() {
                const startDate = eventDetails.startTime;
                const endDate = new Date(startDate.getTime() + eventDetails.duration * 60000);
                
                const params = new URLSearchParams({
                    action: 'TEMPLATE',
                    text: eventDetails.title,
                    details: eventDetails.description,
                    location: eventDetails.location,
                    dates: `${formatGoogleDate(startDate)}/${formatGoogleDate(endDate)}`,
                    recur: 'RRULE:FREQ=WEEKLY;BYDAY=SU' // Recurring weekly on Sunday
                });
                
                return `https://calendar.google.com/calendar/render?${params.toString()}`;
            }
            
            // Generate ICS file content for Apple/Outlook
            function generateICS() {
                const startDate = eventDetails.startTime;
                const endDate = new Date(startDate.getTime() + eventDetails.duration * 60000);
                
                // Format date for ICS (yyyyMMddTHHmmss)
                function formatICSDate(date) {
                    return date.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';
                }
                
                const ics = [
                    'BEGIN:VCALENDAR',
                    'VERSION:2.0',
                    'PRODID:-//Grace and Praise Bangladeshi Church//Sunday Worship//EN',
                    'CALSCALE:GREGORIAN',
                    'METHOD:PUBLISH',
                    'BEGIN:VEVENT',
                    `DTSTART:${formatICSDate(startDate)}`,
                    `DTEND:${formatICSDate(endDate)}`,
                    'RRULE:FREQ=WEEKLY;BYDAY=SU',
                    `SUMMARY:${eventDetails.title}`,
                    `DESCRIPTION:${eventDetails.description}`,
                    `LOCATION:${eventDetails.location}`,
                    `UID:sunday-worship-${Date.now()}@gracepraise.church`,
                    'STATUS:CONFIRMED',
                    'SEQUENCE:0',
                    'END:VEVENT',
                    'END:VCALENDAR'
                ].join('\\r\\n');
                
                return ics;
            }
            
            // Set up calendar links when DOM is ready
            document.addEventListener('DOMContentLoaded', function() {
                // Google Calendar link
                const googleLink = document.getElementById('addToGoogleCal');
                if (googleLink) {
                    googleLink.href = generateGoogleCalendarUrl();
                }
                
                // Apple/iCal and Outlook links (ICS file)
                const icsContent = generateICS();
                const icsBlob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
                const icsUrl = URL.createObjectURL(icsBlob);
                
                const appleLink = document.getElementById('addToAppleCal');
                if (appleLink) {
                    appleLink.href = icsUrl;
                }
                
                const outlookLink = document.getElementById('addToOutlookCal');
                if (outlookLink) {
                    outlookLink.href = icsUrl;
                }
            });
        })();
    </script>
