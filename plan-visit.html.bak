    <!-- Main Content -->
    <main id="main-content">
        <!-- Hero-lite Section -->
        <section class="plan-visit-hero">
            <h1>
                <span data-lang="en">Plan Your Visit</span>
                <span data-lang="bn" style="display:none;">আপনার পরিদর্শনের পরিকল্পনা করুন</span>
            </h1>
            <p class="hero-subtitle">
                <span data-lang="en">We're so glad you're thinking about visiting. Here's everything you need to know to feel welcomed and prepared.</span>
                <span data-lang="bn" style="display:none;">আমরা খুবই আনন্দিত যে আপনি আমাদের পরিদর্শন করার কথা ভাবছেন। এখানে আপনার জানা প্রয়োজন সবকিছু আছে।</span>
            </p>
            <p class="hero-address">📍 1325 Richardson Street, CA 92408</p>
        </section>

        <!-- Welcome Video Section -->
        <section class="plan-visit-section welcome-video-section">
            <h2 class="visually-hidden">
                <span data-lang="en">Welcome Video</span>
                <span data-lang="bn" style="display:none;">স্বাগত ভিডিও</span>
            </h2>
            <div class="video-container">
                <div class="video-wrapper">
                    <iframe 
                        src="https://www.youtube.com/embed/dQw4w9WgXcQ" 
                        title="Welcome to Grace and Praise Bangladeshi Church"
                        frameborder="0" 
                        allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                        allowfullscreen
                        loading="lazy"
                        aria-label="Church welcome video">
                    </iframe>
                </div>
                <p class="video-caption">
                    <span data-lang="en">A short welcome from our church family.</span>
                    <span data-lang="bn" style="display:none;">আমাদের চার্চ পরিবার থেকে একটি সংক্ষিপ্ত স্বাগত বার্তা।</span>
                </p>
            </div>

            <!-- Post-Video Invitation -->
            <div class="video-next-step">
                <p class="next-step-text">
                    <span data-lang="en">If you feel led, we would love to meet you in person this Sunday.</span>
                    <span data-lang="bn" style="display:none;">আপনি যদি অনুভব করেন, আমরা এই রবিবার আপনার সাথে দেখা করতে চাই।</span>
                </p>
                <div class="next-step-buttons">
                    <a href="#service-info" class="next-step-link">
                        <span data-lang="en">Plan My Visit</span>
                        <span data-lang="bn" style="display:none;">আমার পরিদর্শনের পরিকল্পনা করুন</span>
                    </a>
                    <a href="calendar.html" class="next-step-link">
                        <span data-lang="en">View Full Calendar</span>
                        <span data-lang="bn" style="display:none;">সম্পূর্ণ ক্যালেন্ডার দেখুন</span>
                    </a>
                </div>
            </div>
        </section>

        <!-- Service Time & Location -->
        <section class="plan-visit-section" id="service-info">
        <section class="plan-visit-section">
            <h2>
                <span data-lang="en">Service Time & Location</span>
                <span data-lang="bn" style="display:none;">সেবা সময় এবং অবস্থান</span>
            </h2>
            <div class="info-card">
                <div class="info-item">
                    <span class="info-icon">🕐</span>
                    <div>
                        <h3>
                            <span data-lang="en">Sunday Worship</span>
                            <span data-lang="bn" style="display:none;">রবিবার উপাসনা</span>
                        </h3>
                        <p><strong>
                            <span data-lang="en">Every Sunday at 5:00 PM</span>
                            <span data-lang="bn" style="display:none;">প্রতি রবিবার সন্ধ্যা ৫:০০ টা</span>
                        </strong></p>
                        <p>
                            <span data-lang="en">Services last about 90 minutes</span>
                            <span data-lang="bn" style="display:none;">সেবা প্রায় ৯০ মিনিট স্থায়ী হয়</span>
                        </p>
                    </div>
                </div>
                <div class="info-item">
                    <span class="info-icon">📍</span>
                    <div>
                        <h3>
                            <span data-lang="en">Location</span>
                            <span data-lang="bn" style="display:none;">অবস্থান</span>
                        </h3>
                        <p><strong>1325 Richardson Street, CA 92408</strong></p>
                        <p><a href="https://maps.google.com/?q=1325+Richardson+Street+CA+92408" target="_blank" rel="noopener">
                            <span data-lang="en">Get Directions →</span>
                            <span data-lang="bn" style="display:none;">দিকনির্দেশনা পান →</span>
                        </a></p>
                    </div>
                </div>
            </div>
            
            <!-- Add to Calendar Section -->
            <div class="add-to-calendar">
                <p class="calendar-intro">
                    <span data-lang="en">📅 Never miss a service! Add our Sunday Worship to your calendar:</span>
                    <span data-lang="bn" style="display:none;">📅 কোনো সেবা মিস করবেন না! আপনার ক্যালেন্ডারে আমাদের রবিবার উপাসনা যোগ করুন:</span>
                </p>
                <div class="calendar-buttons">
                    <a href="#" class="calendar-link" id="addToGoogleCal" target="_blank" rel="noopener">
                        <span class="calendar-icon">🗓️</span>
                        <span data-lang="en">Google Calendar</span>
                        <span data-lang="bn" style="display:none;">গুগল ক্যালেন্ডার</span>
                    </a>
                    <a href="#" class="calendar-link" id="addToAppleCal" download="sunday-worship.ics">
                        <span class="calendar-icon">🍎</span>
                        <span data-lang="en">Apple / iCal</span>
                        <span data-lang="bn" style="display:none;">অ্যাপল / iCal</span>
                    </a>
                    <a href="#" class="calendar-link" id="addToOutlookCal" download="sunday-worship.ics">
                        <span class="calendar-icon">📆</span>
                        <span data-lang="en">Outlook</span>
                        <span data-lang="bn" style="display:none;">আউটলুক</span>
                    </a>
                </div>
                <p class="calendar-note">
                    <span data-lang="en">This will add a recurring reminder for every Sunday at 5:00 PM</span>
                    <span data-lang="bn" style="display:none;">এটি প্রতি রবিবার সন্ধ্যা ৫:০০ টার জন্য একটি পুনরাবৃত্ত অনুস্মারক যোগ করবে</span>
                </p>
            </div>
            
            <div class="section-cta">
                <a href="calendar.html" class="btn btn-primary">
                    <span data-lang="en">View Full Calendar</span>
                    <span data-lang="bn" style="display:none;">সম্পূর্ণ ক্যালেন্ডার দেখুন</span>
                </a>
            </div>
        </section>

        <!-- What to Expect -->
        <section class="plan-visit-section alt-bg">
            <h2>
                <span data-lang="en">What to Expect</span>
                <span data-lang="bn" style="display:none;">কী প্রত্যাশা করবেন</span>
            </h2>
            <div class="expect-content">
                <p class="intro-text">
                    <span data-lang="en">Our Sunday worship is designed to be warm, meaningful, and welcoming. Here's what a typical service looks like:</span>
                    <span data-lang="bn" style="display:none;">আমাদের রবিবার উপাসনা উষ্ণ, অর্থবহ এবং স্বাগত জানানোর জন্য ডিজাইন করা হয়েছে। একটি সাধারণ সেবা এরকম হয়:</span>
                </p>
                <ul class="expect-list">
                    <li>
                        <span data-lang="en">Worship music with heartfelt singing</span>
                        <span data-lang="bn" style="display:none;">হৃদয় দিয়ে গান গাওয়ার সাথে উপাসনা সঙ্গীত</span>
                    </li>
                    <li>
                        <span data-lang="en">Prayer time as a community</span>
                        <span data-lang="bn" style="display:none;">সম্প্রদায় হিসাবে প্রার্থনার সময়</span>
                    </li>
                    <li>
                        <span data-lang="en">Bible-based message that's practical and encouraging</span>
                        <span data-lang="bn" style="display:none;">বাইবেল-ভিত্তিক বার্তা যা ব্যবহারিক এবং উৎসাহজনক</span>
                    </li>
                    <li>
                        <span data-lang="en">Fellowship before and after the service</span>
                        <span data-lang="bn" style="display:none;">সেবার আগে এবং পরে সহভাগিতা</span>
                    </li>
                </ul>
                <p class="reassurance">
                    <span data-lang="en">You can participate as much or as little as you're comfortable with. No one will put you on the spot.</span>
                    <span data-lang="bn" style="display:none;">আপনি যতটা সহজ মনে করেন ততটা অংশগ্রহণ করতে পারেন। কেউ আপনাকে চাপে ফেলবে না।</span>
                </p>
            </div>
        </section>

        <!-- Language & Worship Style -->
        <section class="plan-visit-section">
            <h2>
                <span data-lang="en">Language & Worship Style</span>
                <span data-lang="bn" style="display:none;">ভাষা এবং উপাসনা শৈলী</span>
            </h2>
            <div class="language-content">
                <div class="language-block">
                    <h3>
                        <span data-lang="en">🗣️ Both Bengali and English</span>
                        <span data-lang="bn" style="display:none;">🗣️ বাংলা এবং ইংরেজি উভয়</span>
                    </h3>
                    <p>
                        <span data-lang="en">We use both languages throughout our services, making everyone feel at home. Whether you're more comfortable in Bengali or English, you'll be able to follow along and participate.</span>
                        <span data-lang="bn" style="display:none;">আমরা আমাদের সেবায় উভয় ভাষা ব্যবহার করি, যা সবাইকে বাড়ির মতো অনুভব করায়।</span>
                    </p>
                </div>
                <div class="language-block">
                    <h3>
                        <span data-lang="en">👔 Come As You Are</span>
                        <span data-lang="bn" style="display:none;">👔 যেমন আছেন তেমনই আসুন</span>
                    </h3>
                    <p>
                        <span data-lang="en">There's no dress code. People wear everything from casual clothes to more formal attire. What matters most is that you're here.</span>
                        <span data-lang="bn" style="display:none;">কোনো পোশাক কোড নেই। সবচেয়ে গুরুত্বপূর্ণ বিষয় হল আপনি এখানে আছেন।</span>
                    </p>
                </div>
            </div>
        </section>

        <!-- Upcoming Highlights -->
        <section class="plan-visit-section alt-bg">
            <h2>
                <span data-lang="en">Upcoming Highlights</span>
                <span data-lang="bn" style="display:none;">আগামী গুরুত্বপূর্ণ অনুষ্ঠান</span>
            </h2>
            <p class="intro-text">
                <span data-lang="en">Here are some important dates coming up. Join us as we celebrate and worship together!</span>
                <span data-lang="bn" style="display:none;">এখানে কিছু গুরুত্বপূর্ণ তারিখ আসছে। আমাদের সাথে উদযাপন এবং উপাসনা করুন!</span>
            </p>
            
            <div class="highlights-list" id="upcomingHighlights">
                <!-- Sunday Worship (Always shown) -->
                <div class="highlight-item sunday-worship">
                    <div class="highlight-icon">🙏</div>
                    <div class="highlight-content">
                        <h3>
                            <span data-lang="en">Sunday Worship Service</span>
                            <span data-lang="bn" style="display:none;">রবিবার উপাসনা সেবা</span>
                        </h3>
                        <p class="highlight-date">
                            <span data-lang="en">Every Sunday at 5:00 PM</span>
                            <span data-lang="bn" style="display:none;">প্রতি রবিবার সন্ধ্যা ৫:০০ টা</span>
                        </p>
                        <p class="highlight-desc">
                            <span data-lang="en">Join us for worship, prayer, and fellowship</span>
                            <span data-lang="bn" style="display:none;">উপাসনা, প্রার্থনা এবং সহভাগিতার জন্য আমাদের সাথে যোগ দিন</span>
                        </p>
                    </div>
                </div>
                
                <!-- Dynamic events will be inserted here -->
            </div>
            
            <div class="section-cta">
                <a href="calendar.html" class="btn btn-primary">
                    <span data-lang="en">View Full Calendar</span>
                    <span data-lang="bn" style="display:none;">সম্পূর্ণ ক্যালেন্ডার দেখুন</span>
                </a>
            </div>
        </section>

        <!-- Arrival & Parking -->
        <section class="plan-visit-section">
            <h2>
                <span data-lang="en">Arrival & Parking</span>
                <span data-lang="bn" style="display:none;">আগমন এবং পার্কিং</span>
            </h2>
            <div class="arrival-content">
                <p>
                    <strong>
                        <span data-lang="en">When to Arrive:</span>
                        <span data-lang="bn" style="display:none;">কখন আসবেন:</span>
                    </strong>
                    <span data-lang="en"> We recommend arriving 10-15 minutes early (around 4:45-4:50 PM). This gives you time to find parking, meet a few friendly faces, and settle in before we start.</span>
                    <span data-lang="bn" style="display:none;"> আমরা ১০-১৫ মিনিট আগে আসার পরামর্শ দিই (প্রায় ৪:৪৫-৪:৫০ মিনিট)।</span>
                </p>
                <p>
                    <strong>
                        <span data-lang="en">Parking:</span>
                        <span data-lang="bn" style="display:none;">পার্কিং:</span>
                    </strong>
                    <span data-lang="en"> Free parking is available at the building and in the surrounding area.</span>
                    <span data-lang="bn" style="display:none;"> বিল্ডিং এবং আশেপাশে বিনামূল্যে পার্কিং উপলব্ধ।</span>
                </p>
                <p>
                    <strong>
                        <span data-lang="en">First-Time Visitors:</span>
                        <span data-lang="bn" style="display:none;">প্রথমবার পরিদর্শনকারী:</span>
                    </strong>
                    <span data-lang="en"> When you arrive, let someone know it's your first time! Our greeters will be happy to help you find a seat and answer any questions.</span>
