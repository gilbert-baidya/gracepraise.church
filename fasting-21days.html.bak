    <!-- GLOBAL LAYOUT LOCK — SAFE, DO NOT REMOVE -->
    <style>
        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            max-width: 100%;
            overflow-x: clip;
        }

        /* iOS SAFARI OVERFLOW GUARD — REAL DEVICE FIX */
        @supports (-webkit-touch-callout: none) {
            body {
                overflow-x: clip !important;
            }
        }

        /* CONTAINER DISCIPLINE — PREVENTS HORIZONTAL SCROLL */
        img,
        video,
        iframe {
            max-width: 100%;
            height: auto;
        }

        section,
        main,
        .hero {
            width: 100%;
            max-width: 100%;
        }

        /* DARK MODE TOGGLE BUTTON */
        .dark-mode-toggle {
            background: rgba(45, 122, 143, 0.1);
            border: 2px solid rgba(45, 122, 143, 0.3);
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-left: 15px;
            font-size: 20px;
        }

        .dark-mode-toggle:hover {
            background: rgba(45, 122, 143, 0.2);
            border-color: rgba(45, 122, 143, 0.5);
            transform: scale(1.05);
        }

    .dark-mode-toggle .sun-icon,
    .dark-mode-toggle .moon-icon {
        position: absolute;
        transition: opacity 0.3s ease, transform 0.3s ease;
    }
    
    .dark-mode-toggle .sun-icon {
        opacity: 1;
        transform: rotate(0deg);
    }
    
    .dark-mode-toggle .moon-icon {
        opacity: 0;
        transform: rotate(-180deg);
    }        [data-theme="dark"] .dark-mode-toggle .sun-icon {
            opacity: 0;
            transform: rotate(180deg);
        }

        [data-theme="dark"] .dark-mode-toggle .moon-icon {
            opacity: 1;
            transform: rotate(0deg);
        }

        @media (max-width: 768px) {
            .dark-mode-toggle {
                width: 36px;
                height: 36px;
                font-size: 18px;
                margin-left: 10px;
            }
        }

        /* 21 Days Fasting Unique Styles */
        .fasting-21-hero {
            background: linear-gradient(rgba(59, 130, 246, 0.7), rgba(147, 51, 234, 0.85)),
                url('/Users/gbaidya/.gemini/antigravity/brain/38369f3d-dcd1-4700-a4f7-2633f67e095e/fasting_21days_hero_1769570942683.png') center/cover no-repeat;
            color: white;
            padding: 8.5rem 2rem 4rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .fasting-21-hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(circle at 30% 50%, rgba(255, 255, 255, 0.1) 0%, transparent 50%);
            pointer-events: none;
        }

        .fasting-21-hero h1 {
            font-size: 3.5rem;
            font-weight: 800;
            margin-bottom: 1rem;
            text-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
            position: relative;
            z-index: 1;
        }

        .fasting-21-hero .subtitle {
            font-size: 1.5rem;
            font-weight: 300;
            opacity: 0.95;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
            position: relative;
            z-index: 1;
        }

        .breakthrough-badge {
            display: inline-block;
            background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
            color: white;
            padding: 0.75rem 2rem;
            border-radius: 50px;
            font-weight: 700;
            box-shadow: 0 6px 25px rgba(251, 191, 36, 0.4);
            margin-top: 1.5rem;
            font-size: 1.1rem;
            border: 3px solid white;
            position: relative;
            z-index: 1;
        }

        @media (max-width: 768px) {
            .fasting-21-hero h1 {
                font-size: 2.5rem;
            }

            .fasting-21-hero .subtitle {
                font-size: 1.2rem;
            }
        }
    </style>
</head>

