# ============================================================================
# GPBC ULTRA DEVOTION IMAGE SYSTEM - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control (add to .gitignore)
# ============================================================================

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-proj-your-api-key-here

# Image Generation Model
# Options: dall-e-3 (recommended), dall-e-2
OPENAI_IMAGE_MODEL=dall-e-3

# Image Output Size
# Options: 1024x1024, 1536x1536
# Recommended: 1536x1536 for ministry publishing quality
GPBC_IMAGE_SIZE=1536x1536

# Batch Generation Delay (milliseconds)
# Delay between each image generation to prevent rate limiting
# Recommended: 1500-2000ms
GPBC_BATCH_DELAY_MS=1500

# Maximum Retry Attempts
# Number of times to retry failed image generations
# Recommended: 2-3
GPBC_MAX_RETRIES=2

# Force Regeneration
# Set to 'true' to overwrite existing images (use with caution)
# Default: false (skip existing files)
FORCE_REGEN=false

# ============================================================================
# Cost Estimation (as of 2026)
# ============================================================================
# DALL-E 3 Standard (1536x1536): ~$0.04 per image
# DALL-E 3 HD (1536x1536): ~$0.08 per image
# 
# Full library (~92 images):
# - Standard Quality: ~$3.68 USD
# - HD Quality: ~$7.36 USD
# ============================================================================

